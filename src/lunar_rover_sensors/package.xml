<?xml version="1.0"?>
<package format="3">
  <name>lunar_rover_sensors</name>
  <version>0.2.0</version>
  <description>Raw Mid-360 and Gemini 335 sensor interfaces.</description>
  <maintainer email="maintainer@example.com">Lunar Rover Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
