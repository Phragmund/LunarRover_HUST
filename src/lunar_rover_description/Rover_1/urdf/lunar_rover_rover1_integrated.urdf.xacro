    <parent link="gemini335_link" />
    <child link="gemini335_color_optical_frame" />
  </joint>
  <link name="gemini335_depth_optical_frame" />
  <joint name="gemini335_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="gemini335_color_optical_frame" />
    <child link="gemini335_depth_optical_frame" />
  </joint>
  <link name="camera_color_optical_frame" />
  <joint name="camera_color_optical_alias_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="gemini335_color_optical_frame" />
    <child link="camera_color_optical_frame" />
  </joint>
  <link name="camera_depth_optical_frame" />
  <joint name="camera_depth_optical_alias_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="gemini335_depth_optical_frame" />
    <child link="camera_depth_optical_frame" />
  </joint>
  <ros2_control name="LunarRoverRover1System" type="system">
    <hardware>
      <plugin>$(arg ros2_control_hardware_plugin)</plugin>
    </hardware>
    <joint name="left_front_steering_joint">
      <command_interface name="position">
        <param name="min">-1.0471975512</param>
        <param name="max">1.0471975512</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_front_steering_joint">
      <command_interface name="position">
        <param name="min">-1.0471975512</param>
        <param name="max">1.0471975512</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_rear_steering_joint">
      <command_interface name="position">
        <param name="min">-1.0471975512</param>
        <param name="max">1.0471975512</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_rear_steering_joint">
      <command_interface name="position">
        <param name="min">-1.0471975512</param>
        <param name="max">1.0471975512</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_front_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_front_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_middle_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_middle_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_rear_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_rear_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_rocker_joint">
      <command_interface name="effort">
        <param name="min">-180.0</param>
        <param name="max">180.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_rocker_joint">
      <command_interface name="effort">
        <param name="min">-180.0</param>
        <param name="max">180.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="left_bogie_joint">
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_bogie_joint">
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  <xacro:if value="$(arg use_sim)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controller_config)</parameters>
      </plugin>
      <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/simulation/ground_truth/odometry</odom_topic>
        <odom_covariance_topic>/simulation/ground_truth/odometry_with_covariance</odom_covariance_topic>
        <tf_topic>/simulation/ground_truth/tf</tf_topic>
        <dimensions>3</dimensions>
        <gaussian_noise>0.0</gaussian_noise>
      </plugin>
      <plugin filename="libignition-gazebo-touchplugin-system.so" name="ignition::gazebo::systems::TouchPlugin">
        <target>rock</target>
        <namespace>simulation/rock_collision</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
      <plugin filename="libignition-gazebo-touchplugin-system.so" name="ignition::gazebo::systems::TouchPlugin">
        <target>step</target>
        <namespace>simulation/step_collision</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </gazebo>
    <gazebo reference="RB_Link">
      <mu1>0.80</mu1>
      <mu2>0.50</mu2>
      <kp>300000.0</kp>
      <kd>60.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.10</maxVel>
      <selfCollide>false</selfCollide>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="RM_Link">
      <mu1>0.80</mu1>
      <mu2>0.50</mu2>
      <kp>300000.0</kp>
      <kd>60.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.10</maxVel>
      <selfCollide>false</selfCollide>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="RF_Link">
      <mu1>0.80</mu1>
      <mu2>0.50</mu2>
      <kp>300000.0</kp>
      <kd>60.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.10</maxVel>
      <selfCollide>false</selfCollide>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="LB_Link">
      <mu1>0.80</mu1>
      <mu2>0.50</mu2>
      <kp>300000.0</kp>
      <kd>60.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.10</maxVel>
      <selfCollide>false</selfCollide>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="LM_Link">
      <mu1>0.80</mu1>
      <mu2>0.50</mu2>
      <kp>300000.0</kp>
      <kd>60.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.10</maxVel>
      <selfCollide>false</selfCollide>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="LF_Link">
      <mu1>0.80</mu1>
      <mu2>0.50</mu2>
      <kp>300000.0</kp>
      <kd>60.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.10</maxVel>
      <selfCollide>false</selfCollide>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="mid360_link">
      <sensor name="mid360_gpu_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/mid360/scan</topic>
        <gz_frame_id>livox_frame</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1800</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592654</min_angle>
              <max_angle>3.141592654</max_angle>
            </horizontal>
            <vertical>
              <samples>11</samples>
              <resolution>1</resolution>
              <min_angle>-0.122173048</min_angle>
              <max_angle>0.907571211</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </lidar>
      </sensor>
      <sensor name="mid360_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/mid360/imu</topic>
        <gz_frame_id>livox_imu_frame</gz_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <xacro:if value="$(arg sensor_noise)">
                  <stddev>0.0007</stddev>
                </xacro:if>
                <xacro:unless value="$(arg sensor_noise)">
                  <stddev>0.0</stddev>
                </xacro:unless>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <xacro:if value="$(arg sensor_noise)">
                  <stddev>0.0007</stddev>
                </xacro:if>
                <xacro:unless value="$(arg sensor_noise)">
                  <stddev>0.0</stddev>
                </xacro:unless>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <xacro:if value="$(arg sensor_noise)">
                  <stddev>0.0007</stddev>
                </xacro:if>
                <xacro:unless value="$(arg sensor_noise)">
                  <stddev>0.0</stddev>
                </xacro:unless>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <xacro:if value="$(arg sensor_noise)">
                  <stddev>0.02</stddev>
                </xacro:if>
                <xacro:unless value="$(arg sensor_noise)">
                  <stddev>0.0</stddev>
                </xacro:unless>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <xacro:if value="$(arg sensor_noise)">
                  <stddev>0.02</stddev>
                </xacro:if>
                <xacro:unless value="$(arg sensor_noise)">
                  <stddev>0.0</stddev>
                </xacro:unless>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <xacro:if value="$(arg sensor_noise)">
                  <stddev>0.02</stddev>
                </xacro:if>
                <xacro:unless value="$(arg sensor_noise)">
                  <stddev>0.0</stddev>
                </xacro:unless>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
    <gazebo reference="gemini335_link">
      <sensor name="gemini335_rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <topic>/gemini335</topic>
        <gz_frame_id>gemini335_color_optical_frame</gz_frame_id>
        <camera>
          <optical_frame_id>gemini335_color_optical_frame</optical_frame_id>
          <horizontal_fov>1.570796327</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <xacro:if value="$(arg sensor_noise)">
              <stddev>0.003</stddev>
            </xacro:if>
            <xacro:unless value="$(arg sensor_noise)">
              <stddev>0.0</stddev>
            </xacro:unless>
          </noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
