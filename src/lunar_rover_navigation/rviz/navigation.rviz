Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 160
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: Rover
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: SLAM Map
      Topic:
        Value: /map
    - Alpha: 0.75
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Terrain Traversability
      Topic:
        Value: /terrain/traversability
    - Alpha: 0.85
      Autocompute Intensity Bounds: true
      Class: grid_map_rviz_plugin/GridMap
      Color Layer: traversability
      Color Transformer: GridMapLayer
      Enabled: true
      Height Layer: elevation
      Height Transformer: GridMapLayer
      History Length: 1
      Invert Rainbow: true
      Name: Terrain Elevation
      Show Grid Lines: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain/grid_map
      Use Rainbow: true
    - Alpha: 0.65
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
    - Alpha: 0.75
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Local Costmap
      Topic:
        Value: /local_costmap/costmap
    - Alpha: 0.65
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 200; 120
      Enabled: true
      Name: Traversable Ground
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Value: /terrain/ground
    - Alpha: 1.0
      Class: rviz_default_plugins/PointCloud2
      Color: 230; 50; 35
      Enabled: true
      Name: Terrain Obstacles
      Position Transformer: XYZ
      Size (Pixels): 4
      Style: Squares
      Topic:
        Value: /terrain/obstacles
    - Alpha: 0.45
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Enabled: true
      Name: Mid360
      Position Transformer: XYZ
      Size (Pixels): 1
      Style: Points
      Topic:
        Value: /livox/points
    - Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 120; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Global Plan
      Topic:
        Value: /plan
    - Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 130; 20
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: Local Plan
      Topic:
        Value: /local_plan
  Enabled: true
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: nav2_rviz_plugins/GoalTool
    Topic:
      Value: /goal_pose
Transformation:
  Current:
    Class: rviz_default_plugins/TF
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 9
    Focal Point:
      X: 0
      Y: 0
      Z: 0
    Name: Orbit
    Pitch: 0.65
    Yaw: 0.75
