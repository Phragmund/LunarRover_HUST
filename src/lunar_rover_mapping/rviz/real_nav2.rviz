Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: FAST-LIO map cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /localization/lio_map_cloud
      Style: Points
      Size (Pixels): 2
      Size (m): 0.05
      Color Transformer: Intensity
      Use Fixed Frame: true
      Use rainbow: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Registered scan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /localization/cloud_registered
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 180; 220; 255
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Global costmap
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Color Scheme: costmap
      Draw Behind: true
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Local costmap
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 global plan (bright green)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /plan
      Color: 0; 255; 40
      Line Style: Lines
      Line Width: 0.10
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /trajectories
      Name: MPPI candidate trajectories
      Namespaces:
        All: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: LIO path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /localization/lio_path
      Color: 255; 200; 0
      Line Style: Lines
      Line Width: 0.03
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Yaw: 0.6
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 60
