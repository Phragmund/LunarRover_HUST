<?xml version="1.0"?>
<sdf version="1.8">
  <model name="image_cave_lidar_ceiling">
    <static>true</static>
    <link name="ceiling_link">
      <collision name="ceiling_collision">
        <laser_retro>1.0</laser_retro>
        <geometry>
          <mesh>
            <uri>model://image_cave_lidar_ceiling/meshes/ceiling_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="ceiling_visual">
        <laser_retro>1.0</laser_retro>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://image_cave_lidar_ceiling/meshes/ceiling_faceted.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 0 0</ambient>
          <diffuse>0 0 0 0</diffuse>
          <specular>0 0 0 0</specular>
        </material>
        <transparency>1.0</transparency>
      </visual>
    </link>
  </model>
</sdf>
