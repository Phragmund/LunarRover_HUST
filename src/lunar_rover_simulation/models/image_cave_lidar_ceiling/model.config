<?xml version="1.0"?>
<model>
  <name>Image Cave Lidar Ceiling</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <author>
    <name>Lunar Rover Team</name>
    <email>maintainer@example.com</email>
