<?xml version="1.0"?>
<sdf version="1.8">
  <model name="image_cave_heightmap_terrain">
    <static>true</static>
    <link name="terrain_link">
      <visual name="terrain_visual">
        <geometry>
          <mesh>
            <uri>model://image_cave_heightmap_terrain/meshes/sandstone_terrain_faceted.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.31 0.28 0.23 1</ambient>
          <diffuse>0.48 0.42 0.34 1</diffuse>
          <specular>0.035 0.030 0.025 1</specular>
        </material>
      </visual>
      <collision name="terrain_collision">
        <geometry>
          <mesh>
            <uri>model://image_cave_heightmap_terrain/meshes/sandstone_terrain_closed.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.25</mu>
              <mu2>1.05</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>10000000</kp>
              <kd>100</kd>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
