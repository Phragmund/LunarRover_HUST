<?xml version="1.0"?>
<robot name="lunar_rover">
  <group name="arm">
    <joint name="arm_joint1"/>
    <joint name="arm_joint2"/>
    <joint name="arm_joint3"/>
    <joint name="arm_joint4"/>
  </group>
  <group name="gripper">
    <joint name="arm_joint5"/>
  </group>
  <group_state name="home" group="arm">
    <joint name="arm_joint1" value="0"/>
    <joint name="arm_joint2" value="0"/>
    <joint name="arm_joint3" value="0"/>
    <joint name="arm_joint4" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="arm_joint5" value="0.040"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="arm_joint5" value="0.004"/>
  </group_state>
  <end_effector name="sample_gripper" parent_link="arm_link4" group="gripper" parent_group="arm"/>

  <disable_collisions link1="base_link" link2="arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link" link2="arm_link1" reason="Adjacent"/>
  <disable_collisions link1="arm_link1" link2="arm_link2" reason="Adjacent"/>
  <disable_collisions link1="arm_link2" link2="arm_link3" reason="Adjacent"/>
  <disable_collisions link1="arm_link3" link2="arm_link4" reason="Adjacent"/>
  <disable_collisions link1="arm_link4" link2="arm_link5" reason="Adjacent"/>
  <disable_collisions link1="arm_link4" link2="gemini335_link" reason="Adjacent"/>
  <disable_collisions link1="gemini335_link" link2="gemini335_color_optical_frame" reason="Never"/>
</robot>
