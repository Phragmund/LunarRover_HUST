<?xml version="1.0"?>
<package format="3">
  <name>lunar_rover_bringup</name>
  <version>0.2.0</version>
  <description>Minimal model, control, raw sensor, and visualization bringup.</description>
  <maintainer email="maintainer@example.com">Lunar Rover Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lunar_rover_control</exec_depend>
  <exec_depend>lunar_rover_description</exec_depend>
  <exec_depend>lunar_rover_exploration</exec_depend>
  <exec_depend>lunar_rover_localization</exec_depend>
  <exec_depend>lunar_rover_mapping</exec_depend>
  <exec_depend>lunar_rover_manipulation</exec_depend>
  <exec_depend>lunar_rover_navigation</exec_depend>
  <exec_depend>lunar_rover_sensors</exec_depend>
  <exec_depend>lunar_rover_simulation</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
