<?xml version="1.0"?>
<package format="3">
  <name>lunar_rover_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch and command safety gate for the lunar rover stack.</description>
  <maintainer email="maintainer@example.com">Lunar Rover Maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>lunar_rover_msgs</exec_depend>
  <exec_depend>lunar_rover_description</exec_depend>
  <exec_depend>lunar_rover_simulation</exec_depend>
  <exec_depend>lunar_rover_control</exec_depend>
  <exec_depend>lunar_rover_sensors</exec_depend>
  <exec_depend>lunar_rover_localization</exec_depend>
  <exec_depend>lunar_rover_perception</exec_depend>
  <exec_depend>lunar_rover_navigation</exec_depend>
  <exec_depend>lunar_rover_missions</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
