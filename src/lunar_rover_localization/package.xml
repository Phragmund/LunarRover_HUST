<?xml version="1.0"?>
<package format="3">
  <name>lunar_rover_localization</name>
  <version>0.1.0</version>
  <description>LiDAR-inertial localization launch and TF adapters for the lunar rover.</description>
  <maintainer email="maintainer@example.com">Lunar Rover Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lunar_rover_mapping</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
